{
  "name": "organize-internet",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "generate": "npm run db:generate -w server",
    "migrate": "npm run db:migrate -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
